# Root env for the RealtyRecall docker compose stack.
# For a working voice demo you only need to fill OPENAI_API_KEY below.
# Every other value has a working local default.

# ===== LiveKit (bundled local server; see docker-compose.yml 'livekit') =====
# Dev credentials that match infra/livekit/livekit.yaml. Never use outside local dev.
# The browser connects to ws://localhost:7880; docker-compose overrides the agent's
# LIVEKIT_URL to ws://livekit:7880 (the internal docker hostname). To use LiveKit
# Cloud instead, set these three to your project's wss URL, key, and secret.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ===== Agent: voice providers =====
OPENAI_API_KEY=
AGENT_NAME=realty
AGENT_MAX_CALL_SECONDS=600
BACKEND_URL=http://backend:8080

# ===== CockroachDB agent memory =====
# CockroachDB stores operational data, structured memory, and OpenAI embeddings together.
DATABASE_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_DIMENSIONS=1536
MEMORY_EMBEDDING_CONCURRENCY=4

# ===== cal.com booking (new RealtyRecall calendar event) =====
CAL_API_KEY=
RR_CAL_EVENT_TYPE_ID=
CAL_DEFAULT_TIMEZONE=America/Toronto

# ===== Telnyx (post-call lead handoff SMS to the realtor) =====
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
# The realtor's phone for the post-call lead handoff SMS.
REALTOR_SMS_TO=

# ===== Backend =====
ENV=dev
JWT_SECRET_KEY=change-me-in-prod-change-me-in-prod-32chars-min
CORS_ORIGINS_STR=http://localhost:5173
WIDGET_ALLOWED_ORIGINS_STR=
WIDGET_TOKEN_RATELIMIT_PER_MIN=20
WIDGET_TOKEN_TTL_SECONDS=300
# CockroachDB Compose defaults (DATABASE_URL above is authoritative).
DB_USER=root
DB_PASSWORD=
DB_HOST=db
DB_PORT=26257
DB_NAME=defaultdb
DB_SSL=disable
# PostHog conversion analytics (optional; no-op when unset).
POSTHOG_API_KEY=

# ===== Clerk (multi-tenant realtor console) =====
# The public marketing page and the buyer call widget work without these, but the
# signed-in realtor console (overview, listings, buyers, settings) needs Clerk.
# Get these from your Clerk app dashboard.
CLERK_ISSUER=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Shared secret so the voice worker can act for a tenant. Any long random string.
AGENT_SERVICE_SECRET=

# ===== Frontend (baked into the static build) =====
VITE_TOKEN_ENDPOINT=http://localhost:8000/api/v1/token
VITE_AGENT_NAME=realty
# Clerk publishable key (pk_test_... or pk_live_...). Required for the console.
VITE_CLERK_PUBLISHABLE_KEY=

# ===== Optional =====
# SENTRY_DSN=
