{
  "name": "superrealty",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-02-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "routes": [{ "pattern": "superrealty.mahimai.ca", "custom_domain": true }]
}
