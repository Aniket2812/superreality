---
const GITHUB = "https://github.com/Aniket2812/superreality";
---
<header class="sticky top-0 z-40 border-b border-line/80 bg-paper/85 backdrop-blur-xl">
  <nav class="mx-auto flex h-[4.5rem] max-w-7xl items-center px-5 sm:px-8">
    <a href="/" class="flex items-center gap-2.5 text-[17px] font-bold tracking-[-.04em]" aria-label="wondering home">
      <span class="grid size-8 place-items-center rounded-[11px] bg-accent text-sm text-white">w</span>wondering
    </a>
    <div class="ml-10 hidden items-center gap-7 text-sm text-black/55 md:flex"><a href="#product" class="hover:text-ink">Product</a><a href="#how" class="hover:text-ink">How it works</a><a href="#open" class="hover:text-ink">Open source</a></div>
    <a href={GITHUB} class="btn-primary ml-auto !min-h-9 !px-4">Get wondering</a>
  </nav>
</header>
